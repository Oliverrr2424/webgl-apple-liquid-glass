{
  "name": "apple-liquid-glass-webgl",
  "version": "2.5.1",
  "description": "Apple-style liquid glass in one line. Real WebGL2 refraction of the page behind any HTML element, in Chrome, Safari and Firefox alike - no Chromium-only backdrop-filter SVG trick. React, Vue, Svelte or plain JS.",
  "keywords": [
    "apple-liquid-glass",
    "liquid-glass",
    "liquid-glass-effect",
    "ios26",
    "glassmorphism",
    "frosted-glass",
    "backdrop-filter",
    "blur",
    "refraction",
    "dispersion",
    "webgl2",
    "webgl",
    "glsl",
    "shader",
    "sdf",
    "canvas",
    "ui",
    "ui-components",
    "navbar",
    "toggle",
    "react",
    "vue",
    "svelte",
    "nextjs",
    "vanilla-js",
    "cross-browser",
    "safari",
    "apple-design"
  ],
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oliverrr2424/webgl-apple-liquid-glass.git"
  },
  "homepage": "https://oliverrr2424.github.io/webgl-apple-liquid-glass/",
  "bugs": {
    "url": "https://github.com/Oliverrr2424/webgl-apple-liquid-glass/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/main.d.ts",
  "exports": {
    ".": {
      "types": "./src/main.d.ts",
      "default": "./src/index.js"
    },
    "./v2": {
      "types": "./src/v2.d.ts",
      "default": "./src/v2.js"
    },
    "./v1": {
      "types": "./src/v1.d.ts",
      "default": "./src/v1.js"
    },
    "./dom": {
      "types": "./src/dom.d.ts",
      "default": "./src/dom.js"
    },
    "./controls": {
      "types": "./src/controls.d.ts",
      "default": "./src/controls.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "src/main.d.ts",
    "src/renderer.js",
    "src/shaders.js",
    "src/material.js",
    "src/geometry.js",
    "src/v2.js",
    "src/v2.d.ts",
    "src/v2-shaders.js",
    "src/v2-material.js",
    "src/v2-geometry.js",
    "src/v1.js",
    "src/v1.d.ts",
    "src/dom.js",
    "src/dom.d.ts",
    "src/dom-backdrop.js",
    "src/dom-content.js",
    "src/frame-loop.js",
    "src/controls.js",
    "src/controls.d.ts",
    "assets/wallpapers/abstract-lines.webp",
    "assets/wallpapers/earth-black.png"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/*.test.mjs tools/*.test.mjs",
    "test:browser": "node tools/browser-tests.mjs",
    "test:visual": "node tools/visual.mjs",
    "test:visual:update": "node tools/visual.mjs --update",
    "serve": "python3 -m http.server 8765",
    "shot": "node tools/shot.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
